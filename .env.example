# PkkMind 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# ── 应用 ──────────────────────────────────────────────────────────────────────
APP_NAME=PkkMind
APP_ENV=production
LOG_LEVEL=INFO

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── LLM Provider ──────────────────────────────────────────────────────────────
# anthropic | openai
LLM_PROVIDER=anthropic

# ── Anthropic Claude ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 可选：覆盖为兼容 Anthropic 协议的第三方 API（如 DeepSeek）
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# 可选：覆盖模型名称（默认 claude-3-5-sonnet-20241022）
# 使用 DeepSeek V4 时设为 deepseek-v4-pro；低成本/高并发场景可用 deepseek-v4-flash
# ANTHROPIC_MODEL=deepseek-v4-pro

# ── OpenAI / OpenAI-compatible ────────────────────────────────────────────────
# LLM_PROVIDER=openai 时必填
OPENAI_API_KEY=
OPENAI_MODEL=

# 原生 OpenAI 留空；第三方兼容服务填写其 /v1 地址
OPENAI_BASE_URL=

# 原生 OpenAI 推荐 responses；多数第三方兼容服务使用 chat_completions
OPENAI_API_STYLE=responses

# ── 单 Agent LLM 覆盖（全部可选）─────────────────────────────────────────────
# 未配置时，General / Technical / Billing 全部继承上面的全局 LLM 配置。
# 每个 Agent 可单独覆盖 PROVIDER、MODEL、API_KEY、BASE_URL、API_STYLE。
# 支持的 Agent 名称：GENERAL、TECHNICAL、BILLING。

# 示例 1：全局使用 OpenAI，但 TechnicalAgent 改用 Anthropic
# PKKMIND_TECHNICAL_LLM_PROVIDER=anthropic
# PKKMIND_TECHNICAL_LLM_MODEL=claude-3-5-sonnet-20241022
# PKKMIND_TECHNICAL_LLM_API_KEY=your_anthropic_api_key_here
# PKKMIND_TECHNICAL_LLM_BASE_URL=

# 示例 2：BillingAgent 使用 OpenAI-compatible Chat Completions
# PKKMIND_BILLING_LLM_PROVIDER=openai
# PKKMIND_BILLING_LLM_MODEL=your_billing_model
# PKKMIND_BILLING_LLM_API_KEY=your_provider_api_key
# PKKMIND_BILLING_LLM_BASE_URL=https://provider.example/v1
# PKKMIND_BILLING_LLM_API_STYLE=chat_completions

# 示例 3：只覆盖模型名，provider、key、base_url 和 api_style 继承全局配置
# PKKMIND_GENERAL_LLM_MODEL=gpt-5-mini

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=pkkmind123

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIRECTORY=./data/chroma

# ── 监控 ──────────────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9091
ANOMALY_DETECTION_THRESHOLD=2.0

# ── 评测 ──────────────────────────────────────────────────────────────────────
EVAL_BASELINE_PATH=./data/eval/baseline.json

# ── Skills ───────────────────────────────────────────────────────────────────
# 默认读取项目内 ./skills，支持运行时通过 POST /skills/reload 热加载
PKKMIND_SKILLS_DIR=./skills
PKKMIND_SKILLS_MAX_PROMPT_CHARS=5000

# ── 安全 ──────────────────────────────────────────────────────────────────────
SECRET_KEY=change_this_in_production
JWT_SECRET_KEY=change_this_in_production

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ── 功能开关 ──────────────────────────────────────────────────────────────────
ENABLE_SWAGGER_UI=true
ENABLE_MONITORING=true
ENABLE_EVALUATION=true
